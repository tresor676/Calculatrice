<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Calculatrice</title>
  <style>
    :root{
      font-family: Inter, system-ui, Arial, sans-serif;
      --bg:#f3f4f6;
      --panel:#ffffff;
      --accent:#0b74de;
      --btn:#e6e7ea;
      --btn-dark:#c8cbcf;
      --danger:#ff6b6b;
    }
    body{
      margin:0;
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      background:linear-gradient(180deg,var(--bg),#e9eef6);
      padding:24px;
    }
    .calculator{
      width:320px;
      border-radius:16px;
      box-shadow:0 10px 30px rgba(15,23,42,0.12);
      background:var(--panel);
      overflow:hidden;
    }
    .display{
      padding:18px;
      background:linear-gradient(180deg,#f7fbff,#f1f6ff);
      text-align:right;
      font-size:28px;
      color:#0f172a;
      box-sizing:border-box;
      min-height:78px;
      display:flex;
      flex-direction:column;
      justify-content:center;
    }
    .small{
      font-size:13px;
      color:#64748b;
      opacity:0.9;
    }
    .result{
      font-weight:700;
      font-size:28px;
      color:#0b0f1a;
      word-break:break-all;
    }
    .keys{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:10px;
      padding:16px;
      background:transparent;
    }
    button{
      border:0;
      padding:16px;
      border-radius:10px;
      font-size:18px;
      cursor:pointer;
      box-shadow:0 4px 8px rgba(2,6,23,0.06);
    }
    .btn-neutral{ background:var(--btn); color:#0b1220; }
    .btn-op{ background:var(--accent); color:white; font-weight:600; }
    .btn-wide{ grid-column:span 2; }
    .btn-danger{ background:var(--danger); color:white; }
    @media (max-width:360px){
      .calculator{ width:100%; }
    }
  </style>
</head>
<body>
  <div class="calculator" role="application" aria-label="Calculatrice">
    <div class="display" id="display">
      <div class="small" id="history"> </div>
      <div class="result" id="current">0</div>
    </div>

    <div class="keys" role="group" aria-label="Clavier calculatrice">
      <button class="btn-neutral" data-action="clear">C</button>
      <button class="btn-neutral" data-action="back">⌫</button>
      <button class="btn-neutral" data-value="%" title="Modulo">%</button>
      <button class="btn-op" data-value="/">÷</button>

      <button class="btn-neutral" data-value="7">7</button>
      <button class="btn-neutral" data-value="8">8</button>
      <button class="btn-neutral" data-value="9">9</button>
      <button class="btn-op" data-value="*">×</button>

      <button class="btn-neutral" data-value="4">4</button>
      <button class="btn-neutral" data-value="5">5</button>
      <button class="btn-neutral" data-value="6">6</button>
      <button class="btn-op" data-value="-">−</button>

      <button class="btn-neutral" data-value="1">1</button>
      <button class="btn-neutral" data-value="2">2</button>
      <button class="btn-neutral" data-value="3">3</button>
      <button class="btn-op" data-value="+">+</button>

      <button class="btn-neutral btn-wide" data-value="0">0</button>
      <button class="btn-neutral" data-value=".">.</button>
      <button class="btn-op" data-action="equals">=</button>
    </div>
  </div>

  <script>
    (function(){
      const display = document.getElementById('current');
      const history = document.getElementById('history');
      let expr = '';      // expression shown/evaluée
      let lastEval = '';  // dernière valeur calculée

      function update(){
        display.textContent = expr === '' ? '0' : expr;
      }

      function safeEval(e){
        // Remplace les symboles d'affichage par des opérateurs JS
        // Autorise seulement chiffres, opérateurs +-*/%. et parenthèses
        if(!/^[0-9+\-*/%.() \t]+$/.test(e)) throw new Error('Caractère non autorisé');
        // évite les doubles opérateurs invalides comme "++" sauf un "-" signifiant négatif
        if(/[^0-9)\s.][^0-9.(\s]/.test(e)) { /* laisse la validation à JS mais reste prudent */ }
        // Utilise Function pour evaluation sûre relative (attention: input utilisateur filtré)
        return Function('"use strict"; return (' + e + ')')();
      }

      document.querySelectorAll('button').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          const v = btn.getAttribute('data-value');
          const action = btn.getAttribute('data-action');
          if(action === 'clear'){
            expr = '';
            lastEval = '';
            history.textContent = '';
            update();
            return;
          }
          if(action === 'back'){
            expr = expr.slice(0,-1);
            update();
            return;
          }
          if(action === 'equals'){
            if(expr.trim() === '') return;
            try{
              const result = safeEval(expr.replace(/×/g,'*').replace(/÷/g,'/'));
              history.textContent = expr + ' =';
              expr = String(result);
              lastEval = expr;
              update();
            }catch(err){
              display.textContent = 'Erreur';
              console.error(err);
              setTimeout(()=> { expr = ''; update(); history.textContent = ''; }, 900);
            }
            return;
          }
          // Valeur normale (chiffre, opérateur ou point)
          // Empêche deux points consécutifs dans le même nombre
          if(v === '.'){
            const parts = expr.split(/[\+\-\*\/\%\(\)]/);
            const last = parts[parts.length-1] || '';
            if(last.includes('.')) return;
            if(last === '') expr += '0';
          }
          expr += v;
          update();
        });
      });

      // Keyboard support
      window.addEventListener('keydown', e=>{
        const key = e.key;
        if(key === 'Enter') {
          e.preventDefault();
          document.querySelector('[data-action="equals"]').click();
          return;
        }
        if(key === 'Backspace'){ document.querySelector('[data-action="back"]').click(); return; }
        if(key === 'Escape'){ document.querySelector('[data-action="clear"]').click(); return; }
        if(/^[0-9]$/.test(key)) document.querySelector(`[data-value="${key}"]`).click();
        if(key === '.') document.querySelector('[data-value="."]').click();
        if(key === '+' || key === '-' || key === '*' || key === '/' || key === '%')
          document.querySelector(`[data-value="${key}"]`)?.click();
      });

      update();
    })();
  </script>
</body>
</html>
